# Server
PORT=8000
CORS_ORIGIN=http://localhost:5173

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Gemini API (Google AI Studio)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest
GOOGLE_AI_PROJECT_NAME=GovGuideSA
GOOGLE_AI_PROJECT_NUMBER=your-project-number

# Google Vision API (OCR)
# Option A: path to a service-account JSON key file (local dev)
GOOGLE_APPLICATION_CREDENTIALS=./google-vision-key.json
# Option B: inline service-account JSON (use on platforms without file storage)
# GOOGLE_VISION_CREDENTIALS_JSON={"type":"service_account",...}